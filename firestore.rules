rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'mdjahidulislam1025@gmail.com';
    }
    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function isTeacher() {
      return isAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isLocalizedString(obj, maxLen) {
      return obj is map
        && obj.keys().hasAll(['bn', 'en'])
        && obj.keys().hasOnly(['bn', 'en'])
        && obj.bn is string && obj.bn.size() <= maxLen
        && obj.en is string && obj.en.size() <= maxLen;
    }
    function isAllowedUidsList(uids) {
      return uids is list
        && uids.size() <= 5
        && (uids.size() == 0 || (uids[0] is string && uids[0].size() >= 1 && uids[0].size() <= 128));
    }

    // Validation Blueprints
    function isValidSettings(data) {
      return data.keys().hasAll(['name', 'eiin', 'phone', 'email', 'location', 'updatedAt'])
        && data.keys().hasOnly(['name', 'shortName', 'tagline', 'eiin', 'phone', 'email', 'location', 'schoolPhoto', 'headTeacherName', 'headTeacherMessage', 'headTeacherPhoto', 'latitude', 'longitude', 'updatedAt'])
        && isLocalizedString(data.name, 200)
        && (!('shortName' in data) || (data.shortName is string && data.shortName.size() <= 100))
        && (!('tagline' in data) || isLocalizedString(data.tagline, 300))
        && data.eiin is string && data.eiin.size() >= 1 && data.eiin.size() <= 32
        && data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 40
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && isLocalizedString(data.location, 300)
        && (!('schoolPhoto' in data) || (data.schoolPhoto is string && data.schoolPhoto.size() <= 600000))
        && (!('headTeacherName' in data) || isLocalizedString(data.headTeacherName, 200))
        && (!('headTeacherMessage' in data) || isLocalizedString(data.headTeacherMessage, 2500))
        && (!('headTeacherPhoto' in data) || (data.headTeacherPhoto is string && data.headTeacherPhoto.size() <= 600000))
        && (!('latitude' in data) || (data.latitude is int || data.latitude is float))
        && (!('longitude' in data) || (data.longitude is int || data.longitude is float))
        && data.updatedAt is timestamp;
    }

    function isValidNotice(data) {
      return data.keys().hasAll(['id', 'title', 'date', 'category', 'description', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'date', 'category', 'description', 'pdfUrl', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.title, 300)
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.category is string && data.category in ['General', 'Admission', 'Exam', 'Holiday']
        && isLocalizedString(data.description, 5000)
        && (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 2000))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNews(data) {
      return data.keys().hasAll(['id', 'title', 'summary', 'content', 'category', 'date', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'summary', 'content', 'category', 'date', 'imageUrl', 'author', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.title, 300)
        && isLocalizedString(data.summary, 600)
        && isLocalizedString(data.content, 5000)
        && data.category is string && data.category in ['Academic', 'Achievement', 'Campus', 'Community']
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 600000))
        && (!('author' in data) || (data.author is string && data.author.size() <= 150))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'date', 'time', 'location', 'category', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'date', 'time', 'location', 'category', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.title, 300)
        && isLocalizedString(data.description, 3000)
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.time is string && data.time.size() >= 1 && data.time.size() <= 64
        && isLocalizedString(data.location, 300)
        && data.category is string && data.category in ['Cultural', 'Sports', 'Science', 'Academic']
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['id', 'name', 'designation', 'subject', 'qualification', 'photo', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'designation', 'subject', 'qualification', 'photo', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.name, 200)
        && isLocalizedString(data.designation, 200)
        && isLocalizedString(data.subject, 200)
        && isLocalizedString(data.qualification, 300)
        && data.photo is string && data.photo.size() <= 600000
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEbook(data) {
      return data.keys().hasAll(['id', 'title', 'classId', 'className', 'subject', 'coverUrl', 'downloadUrl', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'classId', 'className', 'subject', 'category', 'description', 'coverUrl', 'downloadUrl', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.title, 300)
        && data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 16
        && isLocalizedString(data.className, 100)
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && (!('category' in data) || (data.category is string && data.category.size() <= 40))
        && (!('description' in data) || isLocalizedString(data.description, 1500))
        && data.coverUrl is string && data.coverUrl.size() <= 600000
        && data.downloadUrl is string && data.downloadUrl.size() <= 2000
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['id', 'url', 'caption', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'url', 'caption', 'mediaType', 'videoUrl', 'category', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 600000
        && isLocalizedString(data.caption, 400)
        && (!('mediaType' in data) || data.mediaType in ['image', 'video'])
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 32))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHoliday(data) {
      return data.keys().hasAll(['id', 'title', 'date', 'duration', 'type', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'date', 'duration', 'type', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.title, 300)
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && isLocalizedString(data.duration, 100)
        && data.type is string && data.type in ['National', 'Religious', 'Seasonal', 'Other']
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmission(data) {
      return data.keys().hasAll(['appId', 'studentName', 'fatherName', 'motherName', 'guardianMobile', 'targetClass', 'targetGroup', 'birthDate', 'address', 'status', 'submittedDate', 'createdAt'])
        && data.keys().hasOnly(['appId', 'studentName', 'fatherName', 'motherName', 'guardianMobile', 'targetClass', 'targetGroup', 'birthDate', 'address', 'prevSchool', 'bloodGroup', 'status', 'submittedDate', 'ownerUid', 'createdAt', 'updatedAt'])
        && isValidId(data.appId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.fatherName is string && data.fatherName.size() >= 1 && data.fatherName.size() <= 150
        && data.motherName is string && data.motherName.size() >= 1 && data.motherName.size() <= 150
        && data.guardianMobile is string && data.guardianMobile.size() >= 6 && data.guardianMobile.size() <= 30
        && data.targetClass is string && data.targetClass.size() >= 1 && data.targetClass.size() <= 40
        && data.targetGroup is string && data.targetGroup.size() >= 1 && data.targetGroup.size() <= 40
        && data.birthDate is string && data.birthDate.size() >= 4 && data.birthDate.size() <= 32
        && data.address is string && data.address.size() >= 2 && data.address.size() <= 400
        && (!('prevSchool' in data) || (data.prevSchool is string && data.prevSchool.size() <= 200))
        && (!('bloodGroup' in data) || (data.bloodGroup is string && data.bloodGroup.size() <= 16))
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && data.submittedDate is string && data.submittedDate.size() >= 1 && data.submittedDate.size() <= 40
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['id', 'name', 'mobile', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'mobile', 'email', 'message', 'status', 'createdAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.mobile is string && data.mobile.size() >= 6 && data.mobile.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.status is string && data.status in ['unread', 'read']
        && data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'photo', 'linkedChildClass', 'linkedChildRoll', 'linkedChildName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.role is string && data.role in ['student', 'teacher', 'parent', 'admin']
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 600000))
        && (!('linkedChildClass' in data) || (data.linkedChildClass is string && data.linkedChildClass.size() <= 16))
        && (!('linkedChildRoll' in data) || (data.linkedChildRoll is string && data.linkedChildRoll.size() <= 20))
        && (!('linkedChildName' in data) || (data.linkedChildName is string && data.linkedChildName.size() <= 150))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.grantedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'roll', 'name', 'classId', 'section', 'guardianMobile', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'roll', 'name', 'classId', 'section', 'guardianMobile', 'studentUid', 'allowedUids', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.section is string && data.section.size() >= 1 && data.section.size() <= 40
        && data.guardianMobile is string && data.guardianMobile.size() >= 6 && data.guardianMobile.size() <= 30
        && (!('studentUid' in data) || isValidId(data.studentUid))
        && (!('allowedUids' in data) || isAllowedUidsList(data.allowedUids))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentAttendance(data) {
      return data.keys().hasAll(['id', 'date', 'classId', 'studentId', 'studentName', 'roll', 'status', 'teacherName', 'isPublished', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'date', 'classId', 'studentId', 'studentName', 'roll', 'status', 'teacherName', 'allowedUids', 'isPublished', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.status is string && data.status in ['present', 'absent', 'late']
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && (!('allowedUids' in data) || isAllowedUidsList(data.allowedUids))
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'date', 'classId', 'teacherName', 'records', 'isPublished', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'date', 'classId', 'teacherName', 'records', 'isPublished', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && data.records is map && data.records.size() <= 300
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHomework(data) {
      return data.keys().hasAll(['id', 'title', 'subject', 'classId', 'description', 'dueDate', 'assignedBy', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'subject', 'classId', 'description', 'dueDate', 'assignedBy', 'isPublic', 'createdDate', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 3000
        && data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 32
        && data.assignedBy is string && data.assignedBy.size() >= 1 && data.assignedBy.size() <= 150
        && (!('createdDate' in data) || (data.createdDate is string && data.createdDate.size() <= 32))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignmentSubmission(data) {
      return data.keys().hasAll(['id', 'homeworkId', 'classId', 'subject', 'studentId', 'studentName', 'roll', 'answerText', 'status', 'submittedDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'homeworkId', 'classId', 'subject', 'studentId', 'studentName', 'roll', 'answerText', 'attachmentUrl', 'status', 'marks', 'feedback', 'submittedDate', 'ownerUid', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.homeworkId)
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.answerText is string && data.answerText.size() >= 2 && data.answerText.size() <= 4000
        && (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 2000))
        && data.status is string && data.status in ['submitted', 'graded']
        && (!('marks' in data) || ((data.marks is int || data.marks is float) && data.marks >= 0 && data.marks <= 100))
        && (!('feedback' in data) || (data.feedback is string && data.feedback.size() <= 1000))
        && data.submittedDate is string && data.submittedDate.size() >= 4 && data.submittedDate.size() <= 32
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExamMark(data) {
      return data.keys().hasAll(['id', 'examTerm', 'classId', 'subject', 'studentId', 'studentName', 'roll', 'totalMarks', 'obtainedMarks', 'grade', 'enteredBy', 'isPublished', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'examTerm', 'classId', 'subject', 'studentId', 'studentName', 'roll', 'totalMarks', 'obtainedMarks', 'grade', 'enteredBy', 'allowedUids', 'isPublished', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.examTerm is string && data.examTerm.size() >= 1 && data.examTerm.size() <= 100
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && (data.totalMarks is int || data.totalMarks is float) && data.totalMarks > 0 && data.totalMarks <= 1000
        && (data.obtainedMarks is int || data.obtainedMarks is float) && data.obtainedMarks >= 0 && data.obtainedMarks <= data.totalMarks
        && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 8
        && data.enteredBy is string && data.enteredBy.size() >= 1 && data.enteredBy.size() <= 150
        && (!('allowedUids' in data) || isAllowedUidsList(data.allowedUids))
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlineExam(data) {
      return data.keys().hasAll(['id', 'title', 'classId', 'subject', 'chapter', 'durationMinutes', 'mode', 'questions', 'createdBy', 'date', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'classId', 'subject', 'chapter', 'durationMinutes', 'mode', 'questions', 'createdBy', 'date', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isLocalizedString(data.title, 300)
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 200
        && (data.durationMinutes is int || data.durationMinutes is float) && data.durationMinutes >= 1 && data.durationMinutes <= 180
        && data.mode is string && data.mode in ['exam', 'practice']
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 60
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 150
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExamAttempt(data) {
      return data.keys().hasAll(['id', 'examId', 'examTitle', 'subject', 'classId', 'studentId', 'studentName', 'roll', 'score', 'totalQuestions', 'percentage', 'answers', 'timeSpentSeconds', 'submittedAt', 'createdAt'])
        && data.keys().hasOnly(['id', 'examId', 'examTitle', 'subject', 'classId', 'studentId', 'studentName', 'roll', 'score', 'totalQuestions', 'percentage', 'answers', 'timeSpentSeconds', 'submittedAt', 'ownerUid', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.examId)
        && data.examTitle is string && data.examTitle.size() >= 1 && data.examTitle.size() <= 300
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && (data.score is int || data.score is float) && data.score >= 0
        && (data.totalQuestions is int || data.totalQuestions is float) && data.totalQuestions >= 1
        && (data.percentage is int || data.percentage is float) && data.percentage >= 0 && data.percentage <= 100
        && data.answers is map && data.answers.size() <= 100
        && (data.timeSpentSeconds is int || data.timeSpentSeconds is float) && data.timeSpentSeconds >= 0
        && data.submittedAt is string && data.submittedAt.size() >= 4 && data.submittedAt.size() <= 64
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.createdAt is timestamp;
    }

    function isValidExamRoutine(data) {
      return data.keys().hasAll(['id', 'examTerm', 'classId', 'subject', 'date', 'time', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'examTerm', 'classId', 'subject', 'date', 'time', 'room', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.examTerm is string && data.examTerm.size() >= 1 && data.examTerm.size() <= 100
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.time is string && data.time.size() >= 1 && data.time.size() <= 64
        && (!('room' in data) || (data.room is string && data.room.size() <= 64))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'classId', 'totalMarks', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'name', 'classId', 'totalMarks', 'teacherName', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 16
        && isLocalizedString(data.name, 200)
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && (data.totalMarks is int || data.totalMarks is float) && data.totalMarks >= 25 && data.totalMarks <= 200
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 150))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParentMessage(data) {
      return data.keys().hasAll(['id', 'parentName', 'studentName', 'classId', 'roll', 'teacherName', 'subject', 'message', 'status', 'createdDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'parentName', 'studentName', 'classId', 'roll', 'teacherName', 'subject', 'message', 'reply', 'repliedBy', 'status', 'createdDate', 'ownerUid', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.parentName is string && data.parentName.size() >= 1 && data.parentName.size() <= 150
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && (!('reply' in data) || (data.reply is string && data.reply.size() <= 2000))
        && (!('repliedBy' in data) || (data.repliedBy is string && data.repliedBy.size() <= 150))
        && data.status is string && data.status in ['open', 'replied']
        && data.createdDate is string && data.createdDate.size() >= 4 && data.createdDate.size() <= 32
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlumniProfile(data) {
      return data.keys().hasAll(['id', 'name', 'batchYear', 'currentRole', 'organization', 'message', 'status', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'batchYear', 'currentRole', 'organization', 'city', 'message', 'photo', 'status', 'isPublic', 'ownerUid', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.batchYear is string && data.batchYear.size() >= 4 && data.batchYear.size() <= 16
        && data.currentRole is string && data.currentRole.size() >= 1 && data.currentRole.size() <= 150
        && data.organization is string && data.organization.size() >= 1 && data.organization.size() <= 200
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 600000))
        && data.status is string && data.status in ['pending', 'approved']
        && data.isPublic is bool
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeacherLeave(data) {
      return data.keys().hasAll(['id', 'teacherId', 'teacherName', 'leaveType', 'startDate', 'endDate', 'reason', 'status', 'submittedDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'teacherId', 'teacherName', 'leaveType', 'startDate', 'endDate', 'reason', 'status', 'adminRemark', 'ownerUid', 'submittedDate', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && data.leaveType is string && data.leaveType in ['Casual', 'Sick', 'Earned', 'Emergency']
        && data.startDate is string && data.startDate.size() >= 4 && data.startDate.size() <= 32
        && data.endDate is string && data.endDate.size() >= 4 && data.endDate.size() <= 32
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 1500
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && (!('adminRemark' in data) || (data.adminRemark is string && data.adminRemark.size() <= 500))
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.submittedDate is string && data.submittedDate.size() >= 4 && data.submittedDate.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentLeave(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'roll', 'classId', 'leaveType', 'startDate', 'endDate', 'reason', 'status', 'submittedDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'studentId', 'studentName', 'roll', 'classId', 'leaveType', 'startDate', 'endDate', 'reason', 'status', 'reviewedBy', 'teacherRemark', 'ownerUid', 'submittedDate', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.leaveType is string && data.leaveType in ['Sick', 'Family', 'Emergency', 'Other']
        && data.startDate is string && data.startDate.size() >= 4 && data.startDate.size() <= 32
        && data.endDate is string && data.endDate.size() >= 4 && data.endDate.size() <= 32
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 1500
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 150))
        && (!('teacherRemark' in data) || (data.teacherRemark is string && data.teacherRemark.size() <= 500))
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && data.submittedDate is string && data.submittedDate.size() >= 4 && data.submittedDate.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmissionStatus(data) {
      return data.keys().hasAll(['appId', 'targetClass', 'targetGroup', 'status', 'submittedDate', 'updatedAt'])
        && data.keys().hasOnly(['appId', 'targetClass', 'targetGroup', 'status', 'submittedDate', 'mobileLast4', 'updatedAt'])
        && isValidId(data.appId)
        && data.targetClass is string && data.targetClass.size() >= 1 && data.targetClass.size() <= 40
        && data.targetGroup is string && data.targetGroup.size() >= 1 && data.targetGroup.size() <= 40
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && data.submittedDate is string && data.submittedDate.size() >= 1 && data.submittedDate.size() <= 40
        && (!('mobileLast4' in data) || (data.mobileLast4 is string && data.mobileLast4.size() <= 8))
        && data.updatedAt is timestamp;
    }

    function isValidParentStudentLink(data) {
      return data.keys().hasAll(['id', 'parentUid', 'parentEmail', 'parentName', 'classId', 'roll', 'relationship', 'status', 'submittedDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'parentUid', 'parentEmail', 'parentName', 'studentId', 'studentName', 'classId', 'roll', 'relationship', 'status', 'approvedBy', 'submittedDate', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.parentUid)
        && data.parentEmail is string && data.parentEmail.size() >= 3 && data.parentEmail.size() <= 150
        && data.parentName is string && data.parentName.size() >= 1 && data.parentName.size() <= 150
        && (!('studentId' in data) || isValidId(data.studentId))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 150))
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.relationship is string && data.relationship in ['Father', 'Mother', 'Guardian']
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 150))
        && data.submittedDate is string && data.submittedDate.size() >= 4 && data.submittedDate.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorName', 'actorEmail', 'actorRole', 'action', 'targetCollection', 'targetId', 'summary', 'createdDate', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorName', 'actorEmail', 'actorRole', 'action', 'targetCollection', 'targetId', 'summary', 'createdDate', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 150
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 150
        && data.actorRole is string && data.actorRole in ['student', 'teacher', 'parent', 'admin']
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 64
        && data.targetCollection is string && data.targetCollection.size() >= 1 && data.targetCollection.size() <= 64
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdDate is string && data.createdDate.size() >= 4 && data.createdDate.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidFeeRecord(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'classId', 'roll', 'title', 'category', 'amount', 'paidAmount', 'dueDate', 'status', 'recordedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'studentId', 'studentName', 'classId', 'roll', 'title', 'category', 'billingMonth', 'amount', 'paidAmount', 'dueDate', 'status', 'paymentMethod', 'receiptNo', 'paidDate', 'recordedBy', 'allowedUids', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 20
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.category is string && data.category in ['Tuition', 'Exam', 'Admission', 'Library', 'Lab', 'Sports', 'Other']
        && (!('billingMonth' in data) || (data.billingMonth is string && data.billingMonth.size() <= 64))
        && (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 500000
        && (data.paidAmount is int || data.paidAmount is float) && data.paidAmount >= 0 && data.paidAmount <= data.amount
        && data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 32
        && data.status is string && data.status in ['pending', 'partial', 'paid', 'waived']
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod in ['Cash', 'bKash', 'Nagad', 'Bank', 'Online']))
        && (!('receiptNo' in data) || (data.receiptNo is string && data.receiptNo.size() <= 64))
        && (!('paidDate' in data) || (data.paidDate is string && data.paidDate.size() <= 32))
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 150
        && (!('allowedUids' in data) || isAllowedUidsList(data.allowedUids))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortalNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'targetRole', 'priority', 'senderName', 'createdDate', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'message', 'targetRole', 'classId', 'priority', 'senderName', 'createdDate', 'createdAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 250
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.targetRole is string && data.targetRole in ['all', 'student', 'parent', 'teacher']
        && (!('classId' in data) || (data.classId is string && data.classId in ['all', '6', '7', '8', '9', '10']))
        && data.priority is string && data.priority in ['normal', 'urgent']
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 150
        && data.createdDate is string && data.createdDate.size() >= 4 && data.createdDate.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidClassRoutine(data) {
      return data.keys().hasAll(['classId', 'className', 'schedule', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['classId', 'className', 'schedule', 'isPublic', 'createdAt', 'updatedAt'])
        && data.classId is string && data.classId in ['6', '7', '8', '9', '10']
        && isLocalizedString(data.className, 100)
        && data.schedule is list && data.schedule.size() >= 1 && data.schedule.size() <= 7
        && data.schedule[0] is map
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection test doc
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Public School Settings
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'main';
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(settingId) && settingId == 'main' && isValidSettings(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId) && settingId == 'main' && isValidSettings(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Notices (Admin & Teacher managed)
    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(noticeId) && isValidNotice(incoming()) && incoming().id == noticeId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(noticeId) && isValidNotice(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(noticeId);
    }

    // School News (Admin & Teacher managed)
    match /news/{newsId} {
      allow get: if isValidId(newsId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(newsId) && isValidNews(incoming()) && incoming().id == newsId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(newsId) && isValidNews(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(newsId);
    }

    // Campus Events (Admin & Teacher managed)
    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(eventId) && isValidEvent(incoming()) && incoming().id == eventId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(eventId) && isValidEvent(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(eventId);
    }

    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && (existing().isPublic == true || isAdmin());
      allow list: if existing().isPublic == true || isAdmin();
      allow create: if isAdmin() && isValidId(teacherId) && isValidTeacher(incoming()) && incoming().id == teacherId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(teacherId) && isValidTeacher(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(teacherId);
    }

    // Digital Library & Study Materials (Admin & Teacher upload)
    match /ebooks/{ebookId} {
      allow get: if isValidId(ebookId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(ebookId) && isValidEbook(incoming()) && incoming().id == ebookId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(ebookId) && isValidEbook(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(ebookId);
    }

    match /gallery/{itemId} {
      allow get: if isValidId(itemId) && (existing().isPublic == true || isAdmin());
      allow list: if existing().isPublic == true || isAdmin();
      allow create: if isAdmin() && isValidId(itemId) && isValidGalleryItem(incoming()) && incoming().id == itemId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(itemId) && isValidGalleryItem(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /holidays/{holidayId} {
      allow get: if isValidId(holidayId) && (existing().isPublic == true || isAdmin());
      allow list: if existing().isPublic == true || isAdmin();
      allow create: if isAdmin() && isValidId(holidayId) && isValidHoliday(incoming()) && incoming().id == holidayId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(holidayId) && isValidHoliday(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(holidayId);
    }

    // PII Protected: Admissions
    match /admissions/{appId} {
      allow get: if isValidId(appId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isAdmin());
      allow list: if (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isAdmin();
      allow create: if isValidId(appId)
        && isValidAdmission(incoming())
        && incoming().appId == appId
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && (!('ownerUid' in incoming()) || (isSignedIn() && incoming().ownerUid == request.auth.uid));
      allow update: if isAdmin()
        && isValidId(appId)
        && isValidAdmission(incoming())
        && incoming().appId == existing().appId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(appId);
    }

    // PII Protected: Contact Messages
    match /contactMessages/{msgId} {
      allow get: if isValidId(msgId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(msgId)
        && isValidContactMessage(incoming())
        && incoming().id == msgId
        && incoming().status == 'unread'
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(msgId)
        && isValidContactMessage(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() && isValidId(msgId);
    }

    // User Profiles & Trusted Admin Registry
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(uid)
        && (isOwner(uid) || isAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == uid
        && (incoming().role in ['student', 'parent'] || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(uid)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'photo', 'linkedChildClass', 'linkedChildRoll', 'linkedChildName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminRecord(incoming()) && incoming().uid == uid && incoming().grantedAt == request.time;
      allow update: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminRecord(incoming()) && incoming().uid == existing().uid && incoming().grantedAt == existing().grantedAt;
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    // Teacher & Student Portal Collections (Isolated PII & Results)
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (isTeacher() || (isSignedIn() && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids));
      allow list: if isTeacher() || (isSignedIn() && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids);
      allow create: if isTeacher() && isValidId(studentId) && isValidStudent(incoming()) && incoming().id == studentId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(studentId) && isValidStudent(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(studentId);
    }

    match /attendance/{attendanceId} {
      allow get: if isValidId(attendanceId) && isTeacher();
      allow list: if isTeacher();
      allow create: if isTeacher() && isValidId(attendanceId) && isValidAttendance(incoming()) && incoming().id == attendanceId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(attendanceId) && isValidAttendance(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(attendanceId);
    }

    match /studentAttendance/{recordId} {
      allow get: if isValidId(recordId) && (isTeacher() || (isSignedIn() && existing().isPublished == true && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids));
      allow list: if isTeacher() || (isSignedIn() && existing().isPublished == true && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids);
      allow create: if isTeacher() && isValidId(recordId) && isValidStudentAttendance(incoming()) && incoming().id == recordId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(recordId) && isValidStudentAttendance(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(recordId);
    }

    match /homework/{homeworkId} {
      allow get: if isValidId(homeworkId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(homeworkId) && isValidHomework(incoming()) && incoming().id == homeworkId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(homeworkId) && isValidHomework(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(homeworkId);
    }

    match /assignmentSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher());
      allow list: if (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher();
      allow create: if isSignedIn()
        && isValidId(submissionId)
        && isValidAssignmentSubmission(incoming())
        && incoming().id == submissionId
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid);
      allow update: if isTeacher()
        && isValidId(submissionId)
        && isValidAssignmentSubmission(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'marks', 'feedback', 'updatedAt']);
      allow delete: if isValidId(submissionId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid && existing().status == 'submitted') || isTeacher());
    }

    match /examMarks/{markId} {
      allow get: if isValidId(markId) && (isTeacher() || (isSignedIn() && existing().isPublished == true && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids));
      allow list: if isTeacher() || (isSignedIn() && existing().isPublished == true && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids);
      allow create: if isTeacher() && isValidId(markId) && isValidExamMark(incoming()) && incoming().id == markId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(markId) && isValidExamMark(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(markId);
    }

    match /onlineExams/{examId} {
      allow get: if isValidId(examId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(examId) && isValidOnlineExam(incoming()) && incoming().id == examId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(examId) && isValidOnlineExam(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(examId);
    }

    match /examAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher());
      allow list: if (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher();
      allow create: if isSignedIn()
        && isValidId(attemptId)
        && isValidExamAttempt(incoming())
        && incoming().id == attemptId
        && incoming().createdAt == request.time
        && (!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid);
      allow delete: if isTeacher() && isValidId(attemptId);
    }

    match /examRoutines/{routineId} {
      allow get: if isValidId(routineId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(routineId) && isValidExamRoutine(incoming()) && incoming().id == routineId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(routineId) && isValidExamRoutine(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(routineId);
    }

    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isAdmin() && isValidId(subjectId) && isValidSubject(incoming()) && incoming().id == subjectId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(subjectId) && isValidSubject(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(subjectId);
    }

    match /parentMessages/{messageId} {
      allow get: if isValidId(messageId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher());
      allow list: if (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher();
      allow create: if isSignedIn()
        && isValidId(messageId)
        && isValidParentMessage(incoming())
        && incoming().id == messageId
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid);
      allow update: if isTeacher()
        && isValidId(messageId)
        && isValidParentMessage(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['reply', 'repliedBy', 'status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(messageId);
    }

    match /alumni/{alumniId} {
      allow get: if isValidId(alumniId) && ((existing().isPublic == true && existing().status == 'approved') || isAdmin() || (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid));
      allow list: if (existing().isPublic == true && existing().status == 'approved') || isAdmin() || (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid);
      allow create: if isValidId(alumniId)
        && isValidAlumniProfile(incoming())
        && incoming().id == alumniId
        && incoming().status == 'pending'
        && incoming().isPublic == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('ownerUid' in incoming()) || (isSignedIn() && incoming().ownerUid == request.auth.uid));
      allow update: if isAdmin()
        && isValidId(alumniId)
        && isValidAlumniProfile(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(alumniId);
    }

    match /teacherLeaves/{leaveId} {
      allow get: if isValidId(leaveId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isAdmin());
      allow list: if (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isAdmin();
      allow create: if isTeacher()
        && isValidId(leaveId)
        && isValidTeacherLeave(incoming())
        && incoming().id == leaveId
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid);
      allow update: if isAdmin()
        && isValidId(leaveId)
        && isValidTeacherLeave(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminRemark', 'updatedAt']);
      allow delete: if isValidId(leaveId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid && existing().status == 'pending') || isAdmin());
    }

    match /studentLeaves/{leaveId} {
      allow get: if isValidId(leaveId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher());
      allow list: if (isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid) || isTeacher();
      allow create: if isSignedIn()
        && isValidId(leaveId)
        && isValidStudentLeave(incoming())
        && incoming().id == leaveId
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid);
      allow update: if isTeacher()
        && isValidId(leaveId)
        && isValidStudentLeave(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'teacherRemark', 'updatedAt']);
      allow delete: if isValidId(leaveId) && ((isSignedIn() && 'ownerUid' in existing() && existing().ownerUid == request.auth.uid && existing().status == 'pending') || isTeacher());
    }

    // Non-PII Public Admission Status Tracking (Exact ID get only, list forbidden)
    match /admission_status/{appId} {
      allow get: if isValidId(appId);
      allow list: if false;
      allow create: if isValidId(appId)
        && isValidAdmissionStatus(incoming())
        && incoming().appId == appId
        && incoming().status == 'pending'
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(appId)
        && isValidAdmissionStatus(incoming())
        && incoming().appId == existing().appId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(appId);
    }

    // Parent-Student Link Requests (Parent creates pending, Teacher/Admin verifies)
    match /parent_student_links/{linkId} {
      allow get: if isValidId(linkId) && ((isSignedIn() && existing().parentUid == request.auth.uid) || isTeacher());
      allow list: if (isSignedIn() && existing().parentUid == request.auth.uid) || isTeacher();
      allow create: if isSignedIn()
        && isValidId(linkId)
        && isValidParentStudentLink(incoming())
        && incoming().id == linkId
        && incoming().parentUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isTeacher()
        && isValidId(linkId)
        && isValidParentStudentLink(incoming())
        && incoming().id == existing().id
        && incoming().parentUid == existing().parentUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'studentId', 'studentName', 'updatedAt']);
      allow delete: if isValidId(linkId) && ((isSignedIn() && existing().parentUid == request.auth.uid && existing().status == 'pending') || isAdmin());
    }

    // Immutable Append-Only Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isTeacher()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Student Fee & Payment Ledger (Isolated per-student access)
    match /fee_records/{feeId} {
      allow get: if isValidId(feeId) && (isTeacher() || (isSignedIn() && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids));
      allow list: if isTeacher() || (isSignedIn() && 'allowedUids' in existing() && request.auth.uid in existing().allowedUids);
      allow create: if isTeacher() && isValidId(feeId) && isValidFeeRecord(incoming()) && incoming().id == feeId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(feeId) && isValidFeeRecord(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isTeacher() && isValidId(feeId);
    }

    // Targeted Portal Notifications (Role & Class Broadcasts)
    match /portal_notifications/{notifId} {
      allow get: if isValidId(notifId) && (existing().targetRole == 'all' || isSignedIn() || isTeacher());
      allow list: if existing().targetRole == 'all' || isSignedIn() || isTeacher();
      allow create: if isTeacher() && isValidId(notifId) && isValidPortalNotification(incoming()) && incoming().id == notifId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isTeacher() && isValidId(notifId);
    }

    // Dynamic Class Routine Schedules (Teacher & Admin managed, Public read)
    match /classRoutines/{classId} {
      allow get: if isValidId(classId) && (existing().isPublic == true || isTeacher());
      allow list: if existing().isPublic == true || isTeacher();
      allow create: if isTeacher() && isValidId(classId) && classId in ['6', '7', '8', '9', '10'] && isValidClassRoutine(incoming()) && incoming().classId == classId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isTeacher() && isValidId(classId) && classId in ['6', '7', '8', '9', '10'] && isValidClassRoutine(incoming()) && incoming().classId == existing().classId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(classId);
    }
  }
}
